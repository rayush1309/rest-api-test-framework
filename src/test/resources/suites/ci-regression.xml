<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CI Regression Suite" verbose="1">
    <listeners>
        <listener class-name="com.sdetlabs.framework.concurrent.ThreadLocalContextListener"/>
        <listener class-name="com.sdetlabs.framework.reporting.AllureReportListener"/>
    </listeners>
    <test name="Regression tests">
        <groups><run><include name="regression"/></run></groups>
        <packages><package name="com.sdetlabs.*"/></packages>
    </test>
</suite>
